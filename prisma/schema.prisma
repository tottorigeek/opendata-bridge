// Prisma schema for OpenData Bridge (官民共存型オープンデータ管理システム)
// Phase 1: base schema. Do not remove fields — later phases depend on them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: 通常のクエリはプーラー(Supabase Supavisor, transaction mode, port 6543,
  //   接続文字列に ?pgbouncer=true が必要)経由。
  // DIRECT_URL: マイグレーション(prisma migrate deploy)は直接続(port 5432)を使う。
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id   String  @id @default(cuid())
  name String
  type OrgType
  /// 組織種別(特に GOVERNMENT)の裏付けが取れているか。
  /// 登録時は自己申告のため常に false。運営が確認して初めて true にする。
  /// カタログの「行政」バッジはこのフラグが true のときだけ正式表示する。
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now())
  users     User[]
  datasets  Dataset[]
}

enum OrgType {
  GOVERNMENT
  PRIVATE
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  apiKeys        ApiKey[]
  sessions       Session[]
}

/// 発行済みセッションの台帳。JWT の jti をそのまま id に使う。
/// JWT はステートレスなので、これが無いとログアウトや漏洩時に失効させられない。
/// 認証時は「署名が有効」かつ「対応する行が存在し revokedAt が null」を要求する。
model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  ADMIN
  MEMBER
}

model Dataset {
  id              String        @id @default(cuid())
  title           String
  description     String        @default("")
  license         String        @default("CC-BY-4.0")
  visibility      Visibility    @default(PRIVATE)
  status          DatasetStatus @default(DRAFT)
  tags            String        @default("") // カンマ区切り
  updateFrequency String        @default("不定期")
  sourceType      SourceType    @default(UPLOADED)
  filePath        String? // storage/datasets/ 配下の相対パス
  columnsJson     String        @default("[]") // カラム名配列のJSON
  rowCount        Int           @default(0)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum Visibility {
  PUBLIC
  ORG_ONLY
  PRIVATE
}

enum DatasetStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum SourceType {
  UPLOADED
  MERGED
}

model ApiKey {
  id String @id @default(cuid())
  /// キー全文の SHA-256(hex)。平文は発行時のレスポンスでしか返さず、保存もしない。
  /// 認証はこのハッシュへの完全一致で行う。
  keyHash String @unique
  /// 一覧のマスク表示用に残す先頭 8 文字(例: "odb_A1b2")。秘密ではない。
  keyPrefix String
  label     String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  callCount Int       @default(0)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

/// 固定ウィンドウ方式のレート制限カウンタ。
/// サーバーレスではプロセスメモリが共有されないため、DB を唯一の集計点にする。
/// bucket 例: "login:foo@example.com" / "signup:ip:1.2.3.4" / "apikey:<id>"
model RateLimit {
  id          String   @id @default(cuid())
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucket, windowStart])
  @@index([windowStart])
}
