# ============================================================================
# Vercel の Marketplace Integration(Supabase)で接続する場合、
# このファイルの DATABASE_URL / DIRECT_URL / SUPABASE_URL などは
# Integration が自動注入する(POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING /
# SUPABASE_URL 等)ため、手動設定は不要です。その場合に手動で足すのは
# 基本 SESSION_SECRET だけ(Supabase Storage を使うなら
# SUPABASE_SERVICE_ROLE_KEY も。詳細は README「Vercel へのデプロイ」を参照)。
# 以下はローカル開発、または Integration を使わず手動設定する場合の雛形です。
# ============================================================================

# --- データベース(Supabase Postgres)-------------------------------------
# Supabase ダッシュボード → Connect(画面上部の Connect ボタン)から取得します。
#
# DATABASE_URL: 通常のクエリ用。プーラー(Supavisor / Transaction mode, ポート 6543)を使い、
#   Prisma では末尾に ?pgbouncer=true を必ず付けます(プリペアドステートメント無効化のため)。
#   例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: マイグレーション(prisma migrate deploy)用の直接続(ポート 5432)。
#   Supabase の Connect → Direct connection(または Session pooler)の文字列を使います。
#   例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- セッション -------------------------------------------------------------
# セッション cookie 署名用の秘密鍵。本番では 32 文字以上のランダム値に差し替える。
# 例: openssl rand -base64 32
#
# NOTE: この値は外部データソースの認証情報(APIキー等)の暗号化鍵の導出にも
#   使われます。変更すると保存済みの認証情報は復号できなくなり、
#   各データソースで認証値の再入力が必要になります。
SESSION_SECRET="change-me-to-a-long-random-secret"

# --- 定期同期(外部データソース / 任意)-------------------------------------
# syncMode = SCHEDULED のデータソースを毎日自動取り込みするための秘密鍵。
# Vercel の環境変数に設定すると、Vercel Cron が /api/cron/sync を呼ぶ際に
# Authorization: Bearer <CRON_SECRET> を自動付与します(スケジュールは vercel.json)。
# 未設定の場合、定期同期エンドポイントは 503 を返して無効化されます
# (誰でも叩ける状態にしないため)。手動同期は未設定でも使えます。
# 例: openssl rand -base64 32
# CRON_SECRET="<random-secret>"

# --- ファイルストレージ(Supabase Storage / 任意)---------------------------
# SUPABASE_URL と SUPABASE_SERVICE_ROLE_KEY が「両方」設定されているとき、
# CSV の保存先が Supabase Storage の非公開バケットになります。
# どちらか一方でも未設定なら、ローカルの storage/datasets/ に保存します。
#
# 値は Supabase ダッシュボード → Project Settings → API から取得します。
#   - SUPABASE_URL: Project URL(例: https://<project-ref>.supabase.co)
#   - SUPABASE_SERVICE_ROLE_KEY: service_role キー(サーバー専用シークレット。絶対に公開しない)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# バケット名(任意。未指定時は "datasets")。Supabase Storage で非公開バケットとして作成しておくこと。
# SUPABASE_STORAGE_BUCKET="datasets"

# --- メール送信(任意)-------------------------------------------------------
# メールアドレスの確認リンク送信・通知メールに使う。未設定の場合、メールは
# 実送信されずサーバーログに出力される(ローカル開発・検証はこのままで完結する)。
#
# 送信トランスポートは上から順に選ばれる(全プロジェクト共通の規約)。
#   1. 自前メール API: MAIL_API_URL + MAIL_API_SECRET
#   2. Resend:         RESEND_API_KEY
#   3. どちらも未設定ならサーバーログへ出力
# いずれの場合も送信元の MAIL_FROM は必要。本番では MAIL_FROM と、
# 1 か 2 のどちらかを必ず設定すること。

# 送信元。"表示名 <addr@domain>" 形式。
# MAIL_FROM="OpenData Bridge <noreply@opendata.towndx.com>"

# 自前メール API(最優先)。Resend 互換の JSON
#   POST {from, to: [...], subject, html?, text?} を
#   Authorization: Bearer <MAIL_API_SECRET> 付きで送る。
# MAIL_API_URL は .php で終わればそのまま、そうでなければ末尾に /emails を付けて呼ぶ。
#   例: https://mail.example.com/api        → https://mail.example.com/api/emails
#       https://example.com/mail/send.php   → そのまま
# MAIL_API_URL="https://mail.example.com/api"
# MAIL_API_SECRET="<random-secret>"

# Resend(自前メール API が未設定のときに使う)
# RESEND_API_KEY="re_..."

# 確認リンクの絶対 URL を組み立てる基点。未設定なら Vercel の注入値、
# それも無ければ http://localhost:3000 を使う。
# APP_URL="https://your-domain.example.com"
