# ============================================================================
# Vercel の Marketplace Integration(Supabase)で接続する場合、
# このファイルの DATABASE_URL / DIRECT_URL / SUPABASE_URL などは
# Integration が自動注入する(POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING /
# SUPABASE_URL 等)ため、手動設定は不要です。その場合に手動で足すのは
# 基本 SESSION_SECRET だけ(Supabase Storage を使うなら
# SUPABASE_SERVICE_ROLE_KEY も。詳細は README「Vercel へのデプロイ」を参照)。
# 以下はローカル開発、または Integration を使わず手動設定する場合の雛形です。
# ============================================================================

# --- データベース(Supabase Postgres)-------------------------------------
# Supabase ダッシュボード → Connect(画面上部の Connect ボタン)から取得します。
#
# DATABASE_URL: 通常のクエリ用。プーラー(Supavisor / Transaction mode, ポート 6543)を使い、
#   Prisma では末尾に ?pgbouncer=true を必ず付けます(プリペアドステートメント無効化のため)。
#   例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: マイグレーション(prisma migrate deploy)用の直接続(ポート 5432)。
#   Supabase の Connect → Direct connection(または Session pooler)の文字列を使います。
#   例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- セッション -------------------------------------------------------------
# セッション cookie 署名用の秘密鍵。本番では 32 文字以上のランダム値に差し替える。
# 例: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-secret"

# --- ファイルストレージ(Supabase Storage / 任意)---------------------------
# SUPABASE_URL と SUPABASE_SERVICE_ROLE_KEY が「両方」設定されているとき、
# CSV の保存先が Supabase Storage の非公開バケットになります。
# どちらか一方でも未設定なら、ローカルの storage/datasets/ に保存します。
#
# 値は Supabase ダッシュボード → Project Settings → API から取得します。
#   - SUPABASE_URL: Project URL(例: https://<project-ref>.supabase.co)
#   - SUPABASE_SERVICE_ROLE_KEY: service_role キー(サーバー専用シークレット。絶対に公開しない)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# バケット名(任意。未指定時は "datasets")。Supabase Storage で非公開バケットとして作成しておくこと。
# SUPABASE_STORAGE_BUCKET="datasets"
