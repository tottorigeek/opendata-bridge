// Prisma schema for OpenData Bridge (官民共存型オープンデータ管理システム)
// Phase 1: base schema. Do not remove fields — later phases depend on them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: 通常のクエリはプーラー(Supabase Supavisor, transaction mode, port 6543,
  //   接続文字列に ?pgbouncer=true が必要)経由。
  // DIRECT_URL: マイグレーション(prisma migrate deploy)は直接続(port 5432)を使う。
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id           String    @id @default(cuid())
  name         String
  type         OrgType
  /// 組織種別(特に GOVERNMENT)の裏付けが取れているか。
  /// 登録時は自己申告のため常に false。運営が確認して初めて true にする。
  /// カタログの「行政」バッジはこのフラグが true のときだけ正式表示する。
  verified     Boolean   @default(false)
  /// 組織が主張しているドメイン(例: pref.tottori.lg.jp)。確認前でも保持する。
  claimedDomain  String?
  /// 確認が取れたドメイン。verified を立てた根拠として残す。
  verifiedDomain String?
  /// ドメイン確認が完了した日時。
  domainVerifiedAt DateTime?
  /// DNS TXT レコードによる確認に使うトークン。主張ドメインを変えると再発行する。
  domainToken    String?
  /// データリクエストの受付範囲。組織ごとに誰から受け取るかを決める。
  requestPolicy RequestPolicy @default(VERIFIED_USERS)
  /// 組織の所在自治体(都道府県 / 市区町村)。lib/regions.ts のマスタ値を入れる。
  /// データセット側に対象地域が未設定のとき、カタログ検索はここへフォールバックする。
  prefecture   String?
  municipality String?
  createdAt    DateTime  @default(now())
  users        User[]
  datasets     Dataset[]
  /// この組織が受け取ったデータリクエスト。
  requests     DataRequest[]

  @@index([prefecture, municipality])
}

enum OrgType {
  GOVERNMENT
  PRIVATE
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(MEMBER)
  /// メールアドレスの確認が完了した日時。未確認は null。
  /// リクエスト機能など「なりすましが問題になる操作」の入口で参照する。
  emailVerifiedAt DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  apiKeys        ApiKey[]
  sessions       Session[]
  emailVerifications EmailVerification[]
  /// メール通知を受け取るか。アプリ内通知は設定にかかわらず必ず作られる
  /// (メールが届かない環境でも見落とさないようにするため)。
  emailNotifications Boolean @default(true)
  /// この人が送ったデータリクエストと、書いた返信。
  dataRequests       DataRequest[]
  requestReplies     DataRequestReply[]
  notifications      Notification[]
}

enum NotificationType {
  /// 自組織宛にデータリクエストが届いた。
  REQUEST_RECEIVED
  /// 関わっているリクエストに返信がついた。
  REQUEST_REPLIED
  /// 送ったリクエストの状態が変わった。
  REQUEST_STATUS_CHANGED
}

/// アプリ内通知。
///
/// メール送信は環境によって使えない(プロバイダ未設定・到達不能)ため、
/// 通知の正本はこのテーブルに置く。メールはあくまで補助的な配信手段。
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String           @default("")
  /// クリック時の遷移先(アプリ内の相対パス)。
  link   String
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// データリクエストの受付範囲。
enum RequestPolicy {
  /// メール確認済みの利用者なら誰でも送れる。住民やシビックテックの指摘を拾える。
  VERIFIED_USERS
  /// 確認済み組織に所属する人だけが送れる。
  VERIFIED_ORGS
  /// 受け付けない。
  CLOSED
}

enum RequestKind {
  /// 新しいデータの公開依頼。
  CREATE
  /// 既存データの修正依頼。
  FIX
}

enum RequestStatus {
  /// 受付済み・未対応。
  OPEN
  /// 対応中。
  IN_PROGRESS
  /// 対応して完了した。
  RESOLVED
  /// 対応しないと判断した。
  DECLINED
}

/// 組織へのデータリクエスト(公開依頼 / 修正依頼)。
///
/// 現時点では文章でのやり取りに限り、CSV の差分提案は扱わない。
/// 差分提案はバージョン機能に依存するため、そちらの実装後に足す
/// (docs/design/merge-design.md の実装順序 5)。
model DataRequest {
  id             String        @id @default(cuid())
  /// 宛先の組織。
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 修正依頼のとき、対象のデータセット。公開依頼では null。
  /// 対象が削除されても依頼自体は残す。
  datasetId      String?
  dataset        Dataset?      @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  /// 送信者。退会しても依頼は残すため任意参照にする。
  requesterId    String?
  requester      User?         @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  /// 送信時点の送信者名と組織名の写し(退会・改名後も誰からの依頼か分かるように)。
  requesterName  String
  requesterOrgName String

  kind   RequestKind
  status RequestStatus @default(OPEN)
  title  String
  body   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies DataRequestReply[]

  @@index([organizationId, status])
  @@index([datasetId])
}

/// リクエストへの返信。送信者と受け取った組織の双方が書ける。
model DataRequestReply {
  id        String      @id @default(cuid())
  requestId String
  request   DataRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// 投稿時点の著者名の写し。
  authorName String
  /// 受け取った組織側からの返信か(表示の出し分けに使う)。
  fromOrganization Boolean @default(false)
  body      String
  createdAt DateTime @default(now())

  @@index([requestId])
}

/// メール確認トークン。
///
/// 平文のトークンは本人へ送るリンクにしか現れず、DB にはハッシュだけを持つ
/// (API キーと同じ方針)。漏洩時に DB の値からリンクを復元できないようにするため。
model EmailVerification {
  id        String @id @default(cuid())
  /// トークンの SHA-256(hex)。
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 発行時点の宛先。発行後にメールアドレスが変わった場合、このトークンは無効とする。
  email     String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// 発行済みセッションの台帳。JWT の jti をそのまま id に使う。
/// JWT はステートレスなので、これが無いとログアウトや漏洩時に失効させられない。
/// 認証時は「署名が有効」かつ「対応する行が存在し revokedAt が null」を要求する。
model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  ADMIN
  MEMBER
}

model Dataset {
  id              String        @id @default(cuid())
  title           String
  description     String        @default("")
  license         String        @default("CC-BY-4.0")
  visibility      Visibility    @default(PRIVATE)
  status          DatasetStatus @default(DRAFT)
  tags            String        @default("") // カンマ区切り
  updateFrequency String        @default("不定期")
  sourceType      SourceType    @default(UPLOADED)
  filePath        String? // storage/datasets/ 配下の相対パス
  columnsJson     String        @default("[]") // カラム名配列のJSON
  rowCount        Int           @default(0)
  /// データが対象とする地域(都道府県 / 市区町村)。lib/regions.ts のマスタ値を入れる。
  /// この 2 列は 1 組の「対象地域」として扱う。prefecture が null のときだけ
  /// 発行組織の所在地へフォールバックし、prefecture だけ継承することはしない
  /// (例: 対象地域が島根県のデータに、組織所在地の鳥取市が混ざるのを防ぐ)。
  prefecture      String?
  municipality    String?
  /// ライセンスが確定していない状態。マージ結果で入力のライセンスから
  /// 自動判定できなかったときに true になる。true の間は公開申請を通さない
  /// (docs/design/merge-design.md §3-2)。
  licenseUnresolved Boolean     @default(false)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  /// 外部 API から取り込む場合の接続設定(sourceType = API のとき設定される)。
  dataSource      DataSource?
  /// このデータセットがマージで生成された場合の来歴(sourceType = MERGED のとき)。
  lineage         MergeLineage? @relation("MergeOutput")
  /// このデータセットを入力として使ったマージの記録。
  usedInMerges    MergeLineageInput[] @relation("MergeInput")
  /// このデータセットに対する修正リクエスト。
  requests        DataRequest[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([prefecture, municipality])
}

/// マージ結果の来歴。生成された Dataset 1 件につき 1 行。
///
/// 説明文に日本語で書くのではなく構造化して保存するのは、
///   - 元データセットを辿れるようにするため(多段のマージでも祖先を追える)
///   - 統計を前回値と比較できるようにするため(自動追従の品質ゲートの基準)
/// の 2 点による。詳細は docs/design/merge-design.md §3。
model MergeLineage {
  id        String  @id @default(cuid())
  datasetId String  @unique
  dataset   Dataset @relation("MergeOutput", fields: [datasetId], references: [id], onDelete: Cascade)

  /// マージ型("extend" | "intersect")。
  kind  String
  keyA  String
  keyB  String
  /// 正規化レベル("address" 等)。
  level String

  /// キー照合の指標一式(lib/merge/metrics.ts の KeyAnalysis)の JSON。
  /// 相性チェックと同じ計算から得た値で、品質の推移を追う基準になる。
  statsJson String @default("{}")
  /// 出力列 → 由来(どちらの入力のどの列か)の対応の JSON。
  columnOriginsJson String @default("[]")

  createdAt DateTime @default(now())

  inputs MergeLineageInput[]
}

/// マージの入力 1 件分の記録。
///
/// 元データセットへの参照に加えて、マージ時点のタイトル・ライセンス・組織名・
/// 内容ハッシュを写しておく。来歴は「その時点の事実の記録」であり、
/// 元が削除・改名されても壊れてはならないため。
model MergeLineageInput {
  id        String       @id @default(cuid())
  lineageId String
  lineage   MergeLineage @relation(fields: [lineageId], references: [id], onDelete: Cascade)

  /// どちら側の入力か("A" | "B")。
  side String

  /// 元データセット。削除されると null になるが、以下の写しは残る。
  datasetId String?
  dataset   Dataset? @relation("MergeInput", fields: [datasetId], references: [id], onDelete: SetNull)

  /// マージ時点の値の写し。
  title            String
  license          String
  organizationName String
  rowCount         Int    @default(0)
  /// マージ時点の CSV の SHA-256(hex)。出典が更新されたかを判定できる。
  contentHash      String @default("")

  @@index([lineageId])
  @@index([datasetId])
}

enum Visibility {
  PUBLIC
  ORG_ONLY
  PRIVATE
}

enum DatasetStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum SourceType {
  UPLOADED
  MERGED
  /// 外部 API / CSV URL から定期的に取り込んでいるデータセット。
  API
}

/// 外部データソースの接続設定(Dataset と 1:1)。
///
/// 取り込んだデータは既存の CSV ストレージへ materialize する。こうすると
/// カタログ・ダウンロード・マージエンジン・公開 API v1 は「CSV を読む」という
/// 従来どおりの経路のままで、アップロード由来のデータセットと完全に共存できる。
/// つまり本モデルは「CSV を誰が埋めるか(人か外部システムか)」だけを足している。
model DataSource {
  id        String  @id @default(cuid())
  datasetId String  @unique
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  kind     SourceKind
  /// 取得先 URL。SSRF 対策のため、実行時に必ず lib/sources/fetch.ts の検証を通す。
  endpoint String

  authType      SourceAuthType @default(NONE)
  /// 認証値(APIキー等)を AES-256-GCM で暗号化したもの。平文では保存しない。
  authValueEnc  String         @default("")
  /// authType = HEADER のときのヘッダ名 / QUERY のときのクエリパラメータ名。
  authParamName String         @default("")

  /// REST_JSON のとき、レコード配列が入っている場所(例: "result.records")。
  /// 空ならレスポンス直下が配列であることを期待する。
  recordsPath  String @default("")
  /// 列マッピング [{ from, to }] の JSON。空配列なら取得側のキーをそのまま列名にする。
  fieldMapJson String @default("[]")

  syncMode SyncMode @default(MANUAL)

  lastSyncedAt DateTime?
  lastStatus   SyncStatus?
  lastMessage  String      @default("")
  lastRowCount Int         @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  runs      SyncRun[]

  @@index([syncMode])
}

enum SourceKind {
  /// JSON を返す REST API(CKAN datastore_search など)。
  REST_JSON
  /// CSV を直接返す URL。
  CSV_URL
}

enum SourceAuthType {
  NONE
  /// Authorization: Bearer <値>
  BEARER
  /// 任意ヘッダ(authParamName: 値)
  HEADER
  /// クエリパラメータ(?authParamName=値)
  QUERY
}

enum SyncMode {
  /// 手動実行のみ。
  MANUAL
  /// 定期実行(cron)の対象にする。
  SCHEDULED
}

enum SyncStatus {
  SUCCESS
  FAILED
}

/// 同期の実行履歴。失敗の原因追跡と、定期実行が動いているかの確認に使う。
model SyncRun {
  id           String     @id @default(cuid())
  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  status       SyncStatus
  rowCount     Int        @default(0)
  message      String     @default("")
  /// 手動実行か定期実行か。
  triggeredBy  String     @default("manual")
  startedAt    DateTime   @default(now())
  durationMs   Int        @default(0)

  @@index([dataSourceId, startedAt])
}

model ApiKey {
  id        String    @id @default(cuid())
  /// キー全文の SHA-256(hex)。平文は発行時のレスポンスでしか返さず、保存もしない。
  /// 認証はこのハッシュへの完全一致で行う。
  keyHash   String    @unique
  /// 一覧のマスク表示用に残す先頭 8 文字(例: "odb_A1b2")。秘密ではない。
  keyPrefix String
  label     String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  callCount Int       @default(0)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

/// 固定ウィンドウ方式のレート制限カウンタ。
/// サーバーレスではプロセスメモリが共有されないため、DB を唯一の集計点にする。
/// bucket 例: "login:foo@example.com" / "signup:ip:1.2.3.4" / "apikey:<id>"
model RateLimit {
  id          String   @id @default(cuid())
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucket, windowStart])
  @@index([windowStart])
}
